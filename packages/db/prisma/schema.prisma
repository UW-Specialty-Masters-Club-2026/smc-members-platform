// SMC platform schema (MySQL 8+).
// All DateTime columns hold UTC; Pacific Time is applied only when formatting.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Members & access ──────────────────────────────────────────────

enum MemberRole {
  MEMBER
  ORGANIZER
  ADMIN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

/// Why news emails are switched off without the member asking in the profile.
enum EmailSuppressionReason {
  UNSUBSCRIBED
  COMPLAINED
  HARD_BOUNCE
}

model Member {
  id        String       @id @default(cuid())
  /// Stored lower-cased and trimmed.
  email     String       @unique @db.VarChar(320)
  firstName String       @map("first_name") @db.VarChar(100)
  lastName  String       @map("last_name") @db.VarChar(100)
  role      MemberRole   @default(MEMBER)
  status    MemberStatus @default(ACTIVE)

  emailVerifiedAt DateTime? @map("email_verified_at")

  /// "Send me extra news and invitations" — chosen at sign-up, editable in My profile.
  newsOptIn             Boolean                 @default(false) @map("news_opt_in")
  newsOptInUpdatedAt    DateTime?               @map("news_opt_in_updated_at")
  emailSuppressedReason EmailSuppressionReason? @map("email_suppressed_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  magicLinks       MagicLinkToken[]
  registrations    Registration[]
  eventsCreated    Event[]          @relation("EventCreatedBy")
  attendance       Attendance[]     @relation("AttendanceMember")
  checkInsDone     Attendance[]     @relation("AttendanceStaff")
  surveyResponses  SurveyResponse[]
  newsPosts        NewsPost[]       @relation("NewsAuthor")
  digestsApproved  WeeklyDigest[]   @relation("DigestApprovedBy")
  digestsRejected  WeeklyDigest[]   @relation("DigestRejectedBy")
  digestDeliveries DigestDelivery[]

  @@index([status, newsOptIn, emailVerifiedAt])
  @@map("members")
}

enum MagicLinkPurpose {
  /// Sign-up confirmation: verifies the email and signs in.
  SIGNUP
  LOGIN
}

model MagicLinkToken {
  id        String           @id @default(cuid())
  memberId  String           @map("member_id")
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// SHA-256 of the raw token; the raw token only ever lives in the email.
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  purpose   MagicLinkPurpose
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@map("magic_link_tokens")
}

model Session {
  id         String    @id @default(cuid())
  memberId   String    @map("member_id")
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie value.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([memberId])
  @@map("sessions")
}

// ─── Events & registrations ────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

model Event {
  id      String      @id @default(cuid())
  slug    String      @unique @db.VarChar(120)
  title   String      @db.VarChar(160)
  /// One line, shown in listings and the weekly digest.
  summary String      @db.VarChar(280)
  /// Full description for the event page.
  details String?     @db.Text
  status  EventStatus @default(DRAFT)

  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")
  /// e.g. "PACCAR Hall, Room 192 · UW Seattle"
  location String    @db.VarChar(200)

  /// null = unlimited seats.
  capacity             Int?
  waitlistEnabled      Boolean   @default(true) @map("waitlist_enabled")
  registrationOpen     Boolean   @default(true) @map("registration_open")
  registrationClosesAt DateTime? @map("registration_closes_at")

  publishedAt DateTime? @map("published_at")
  cancelledAt DateTime? @map("cancelled_at")
  completedAt DateTime? @map("completed_at")

  createdById String   @map("created_by_id")
  createdBy   Member   @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  registrations Registration[]
  attendance    Attendance[]
  survey        Survey?

  @@index([status, startsAt])
  @@map("events")
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

/// One row per member per event; re-registering after cancelling reuses the row.
model Registration {
  id       String             @id @default(cuid())
  eventId  String             @map("event_id")
  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String             @map("member_id")
  member   Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status   RegistrationStatus

  /// When the member (re-)joined; orders the waitlist.
  registeredAt DateTime  @map("registered_at")
  confirmedAt  DateTime? @map("confirmed_at")
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  attendance Attendance?

  @@unique([eventId, memberId])
  @@index([eventId, status, registeredAt])
  @@index([memberId, status])
  @@map("registrations")
}

// ─── QR attendance ─────────────────────────────────────────────────

enum CheckInMethod {
  QR
  MANUAL
}

/// A member checked in at an event. Unique per registration, so a re-scan never doubles up.
model Attendance {
  id             String        @id @default(cuid())
  eventId        String        @map("event_id")
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String        @unique @map("registration_id")
  registration   Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  memberId       String        @map("member_id")
  member         Member        @relation("AttendanceMember", fields: [memberId], references: [id], onDelete: Cascade)
  method         CheckInMethod
  checkedInAt    DateTime      @map("checked_in_at")
  checkedInById  String        @map("checked_in_by_id")
  checkedInBy    Member        @relation("AttendanceStaff", fields: [checkedInById], references: [id])

  @@unique([eventId, memberId])
  @@map("attendance")
}

// ─── Surveys ───────────────────────────────────────────────────────

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SurveyAudience {
  /// Members who checked in.
  ATTENDEES
  /// Members with a confirmed registration (for events without check-in).
  REGISTRANTS
}

enum SurveyQuestionKind {
  RATING
  TEXT
  SINGLE_CHOICE
}

/// Post-event feedback form; at most one per event.
model Survey {
  id       String         @id @default(cuid())
  eventId  String         @unique @map("event_id")
  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title    String         @db.VarChar(160)
  intro    String?        @db.VarChar(1000)
  audience SurveyAudience @default(ATTENDEES)
  status   SurveyStatus   @default(DRAFT)

  openedAt  DateTime? @map("opened_at")
  closesAt  DateTime? @map("closes_at")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String             @id @default(cuid())
  surveyId String             @map("survey_id")
  survey   Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  position Int
  kind     SurveyQuestionKind
  prompt   String             @db.VarChar(300)
  required Boolean            @default(true)
  /// SINGLE_CHOICE options, e.g. ["Yes", "No"]
  options  Json?

  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@map("survey_questions")
}

/// One per member per survey. Results are shown to staff without names.
model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String   @map("survey_id")
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId    String   @map("member_id")
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  submittedAt DateTime @map("submitted_at")

  answers SurveyAnswer[]

  @@unique([surveyId, memberId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id         String         @id @default(cuid())
  responseId String         @map("response_id")
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String         @map("question_id")
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rating     Int?
  text       String?        @db.Text
  choice     String?        @db.VarChar(200)

  @@unique([responseId, questionId])
  @@map("survey_answers")
}

// ─── Club news ─────────────────────────────────────────────────────

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NewsPost {
  id      String     @id @default(cuid())
  slug    String     @unique @db.VarChar(120)
  /// Optional label shown above the title, e.g. "NOW RECRUITING".
  tag     String?    @db.VarChar(40)
  title   String     @db.VarChar(160)
  /// Short description used in listings and the weekly digest.
  summary String     @db.VarChar(600)
  body    String?    @db.Text
  /// "Read more" target when the story lives elsewhere; otherwise the club's news page.
  linkUrl String?    @map("link_url") @db.VarChar(500)
  status  NewsStatus @default(DRAFT)

  /// Recruiting posts: who to email and what to include (rendered as the "How to apply" box).
  applyEmail     String? @map("apply_email") @db.VarChar(320)
  /// string[]
  applyChecklist Json?   @map("apply_checklist")

  publishedAt DateTime? @map("published_at")
  createdById String    @map("created_by_id")
  createdBy   Member    @relation("NewsAuthor", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  openings NewsOpening[]

  @@index([status, publishedAt])
  @@map("news_posts")
}

/// One open role in a recruiting post (rendered as the numbered list in the digest).
model NewsOpening {
  id         String   @id @default(cuid())
  newsPostId String   @map("news_post_id")
  newsPost   NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  position   Int
  title      String   @db.VarChar(120)
  openings   Int      @default(1)

  @@unique([newsPostId, position])
  @@map("news_openings")
}

// ─── Weekly digest ─────────────────────────────────────────────────

/// Single row (id = 1): lets admins pause the digest outside the academic term.
model DigestSettings {
  id           Int       @id @default(1)
  paused       Boolean   @default(false)
  /// Resume automatically from this instant (null = until unpaused by hand).
  pausedUntil  DateTime? @map("paused_until")
  pausedReason String?   @map("paused_reason") @db.VarChar(300)
  updatedById  String?   @map("updated_by_id") @db.VarChar(64)
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("digest_settings")
}

enum DigestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  PARTIALLY_FAILED
  REJECTED
  EXPIRED
  SKIPPED
}

enum DigestSummarySource {
  TEMPLATE
  AI
}

model WeeklyDigest {
  id          String       @id @default(cuid())
  /// The Monday this issue belongs to, as a Pacific calendar date ("2026-10-26").
  weekKey     String       @unique @map("week_key") @db.VarChar(10)
  /// Assigned on approval, so expired/skipped weeks don't use up a number.
  issueNumber Int?         @unique @map("issue_number")
  status      DigestStatus @default(DRAFT)

  /// News published in [windowStart, windowEnd) is included.
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")

  /// Exactly what the admin previewed and approved: facts copied from the database.
  contentSnapshot Json?                @map("content_snapshot")
  summaryText     String?              @map("summary_text") @db.VarChar(300)
  summarySource   DigestSummarySource? @map("summary_source")
  subject         String?              @db.VarChar(200)
  html            String?              @db.MediumText
  text            String?              @db.MediumText

  recipientCountPreview Int? @map("recipient_count_preview")

  /// Never send before this (Monday 09:00 PT); unapproved digests expire at expiresAt (18:00 PT).
  sendNotBefore DateTime @map("send_not_before")
  expiresAt     DateTime @map("expires_at")

  approvedById String?   @map("approved_by_id")
  approvedBy   Member?   @relation("DigestApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")
  rejectedById String?   @map("rejected_by_id")
  rejectedBy   Member?   @relation("DigestRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt   DateTime? @map("rejected_at")
  rejectReason String?   @map("reject_reason") @db.VarChar(500)
  skipReason   String?   @map("skip_reason") @db.VarChar(300)

  sendingStartedAt DateTime? @map("sending_started_at")
  completedAt      DateTime? @map("completed_at")

  /// Optimistic lock: every state change bumps it.
  version   Int      @default(0)
  /// Run that created the draft (correlates with audit_logs.run_id).
  runId     String   @map("run_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batches    DigestBatch[]
  deliveries DigestDelivery[]

  @@index([status])
  @@map("weekly_digests")
}

enum DigestBatchStatus {
  PENDING
  SENDING
  SUBMITTED
  RETRY_SCHEDULED
  /// Request outcome unknown (e.g. timeout): must be reconciled before any retry.
  UNKNOWN
  FAILED
}

/// One Mailgun batch request (≤ 1000 recipients).
model DigestBatch {
  id               String            @id @default(cuid())
  digestId         String            @map("digest_id")
  digest           WeeklyDigest      @relation(fields: [digestId], references: [id], onDelete: Cascade)
  batchNo          Int               @map("batch_no")
  status           DigestBatchStatus @default(PENDING)
  recipientCount   Int               @map("recipient_count")
  attempts         Int               @default(0)
  nextAttemptAt    DateTime?         @map("next_attempt_at")
  mailgunMessageId String?           @map("mailgun_message_id") @db.VarChar(255)
  lastError        String?           @map("last_error") @db.VarChar(1000)
  submittedAt      DateTime?         @map("submitted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  deliveries DigestDelivery[]

  @@unique([digestId, batchNo])
  @@index([status, nextAttemptAt])
  @@map("digest_batches")
}

enum DeliveryStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  TEMP_FAILED
  FAILED
  COMPLAINED
  UNSUBSCRIBED
  /// Dropped at send time (opted out or suppressed after approval).
  SKIPPED
}

/// One member's copy of one digest. Both unique keys enforce "one digest per member per week".
model DigestDelivery {
  id             String         @id @default(cuid())
  digestId       String         @map("digest_id")
  digest         WeeklyDigest   @relation(fields: [digestId], references: [id], onDelete: Cascade)
  memberId       String         @map("member_id")
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  weekKey        String         @map("week_key") @db.VarChar(10)
  /// "digest:<weekKey>:<memberId>" — sent to Mailgun as v:delivery_id's companion key.
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(120)
  batchId        String?        @map("batch_id")
  batch          DigestBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status         DeliveryStatus @default(QUEUED)

  mailgunMessageId String?   @map("mailgun_message_id") @db.VarChar(255)
  attempts         Int       @default(0)
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(20)
  lastErrorMessage String?   @map("last_error_message") @db.VarChar(1000)
  lastEventAt      DateTime? @map("last_event_at")
  deliveredAt      DateTime? @map("delivered_at")
  failedAt         DateTime? @map("failed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([digestId, memberId])
  @@unique([weekKey, memberId])
  @@index([digestId, status])
  @@index([batchId])
  @@map("digest_deliveries")
}

/// Every Mailgun webhook we accepted. Unique token/id make replays and re-deliveries no-ops.
model MailgunWebhookEvent {
  id             String    @id @default(cuid())
  /// signature.token from the webhook; a replayed request reuses it.
  signatureToken String    @unique @map("signature_token") @db.VarChar(100)
  /// event-data.id; Mailgun may deliver the same event more than once.
  eventId        String    @unique @map("event_id") @db.VarChar(100)
  eventType      String    @map("event_type") @db.VarChar(40)
  deliveryId     String?   @map("delivery_id") @db.VarChar(40)
  /// Minimal, email-masked copy of the payload for troubleshooting.
  payload        Json
  receivedAt     DateTime  @map("received_at")
  processedAt    DateTime? @map("processed_at")

  @@index([deliveryId])
  @@map("mailgun_webhook_events")
}

// ─── Job queue (MySQL-backed) ──────────────────────────────────────

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  /// Gave up after maxAttempts.
  DEAD
  CANCELLED
}

/// Background work. Claimed with SELECT … FOR UPDATE SKIP LOCKED; jobKey makes enqueueing idempotent.
model Job {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(64)
  /// Idempotency key, e.g. "digest.create-draft:2026-10-26". Enqueueing the same key twice is a no-op.
  jobKey      String    @unique @map("job_key") @db.VarChar(191)
  payload     Json
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @map("run_at")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by") @db.VarChar(64)
  lastError   String?   @map("last_error") @db.Text
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("jobs")
}

// ─── Run + audit logs ──────────────────────────────────────────────

enum AuditActorType {
  SYSTEM
  MEMBER
  ADMIN
  WEBHOOK
}

enum AuditResult {
  SUCCESS
  FAILURE
  SKIPPED
  DENIED
}

/// Append-only record of every action, approval, failure, delivery and retry.
model AuditLog {
  id         BigInt         @id @default(autoincrement())
  /// Correlates all entries of one request, job run or webhook delivery.
  runId      String         @map("run_id") @db.VarChar(64)
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.VarChar(64)
  action     String         @db.VarChar(100)
  entityType String?        @map("entity_type") @db.VarChar(50)
  entityId   String?        @map("entity_id") @db.VarChar(64)
  result     AuditResult
  /// Emails are masked before storage.
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([runId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
