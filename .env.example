# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
API_PORT=4000
DATABASE_URL=mysql://smc:smc_local@127.0.0.1:3306/smc
# Prisma migrate dev only (local).
SHADOW_DATABASE_URL=mysql://smc:smc_local@127.0.0.1:3306/smc_shadow
# Integration tests (wiped between test files).
TEST_DATABASE_URL=mysql://smc:smc_local@127.0.0.1:3306/smc_test
MAIL_TRANSPORT=dev-outbox
MAIL_FROM="Specialty Masters Club <news@mail.smc.example>"
# HMAC key for check-in QR codes and unsubscribe links: `openssl rand -base64 48`.
LINK_SIGNING_SECRET=replace-with-48-random-bytes-base64-from-openssl
