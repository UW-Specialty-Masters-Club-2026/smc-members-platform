  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0"
  },
  "dependencies": {
    "@smc/config": "^0.0.0",
    "@smc/core": "^0.0.0",
    "@smc/db": "^0.0.0",
    "@smc/digest": "^0.0.0",
    "@smc/email": "^0.0.0",
    "@smc/jobs": "^0.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "marked": "^18.1.2",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
