{
  "name": "@smc/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "staging:draft": "tsx --env-file-if-exists=../../.env src/scripts/staging-draft.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "seed:content": "tsx --env-file-if-exists=../../.env src/scripts/seed-content.ts"
  },
  "dependencies": {
    "@smc/config": "^0.0.0",
    "@smc/core": "^0.0.0",
    "@smc/db": "^0.0.0",
    "@smc/digest": "^0.0.0",
    "@smc/email": "^0.0.0",
    "@smc/jobs": "^0.0.0",
    "croner": "^10.0.1",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/turndown": "^5.0.6",
    "tsup": "^9.0.0"
  }
}
